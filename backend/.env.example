# Copy this file to .env and paste your keys after the = sign (no quotes, no spaces). One key is enough.

# Gemini (main): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (backup): https://console.groq.com/keys
GROQ_API_KEY=
# OpenAI (optional, paid): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Free-tier friendly limits
MAX_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=10

# Set to false if the app is put online
DEMO_LOGIN=true
