# Copy this file to .env (same folder) and paste your keys after the = sign, with no quotes or spaces.
# One key is enough. Two keys (e.g. Gemini + Groq) give you an automatic backup.
# With no key at all the app still runs in offline (rule-based) mode.

# auto | gemini | openai | groq | ollama | offline   (auto = first provider below that has a key)
LLM_PROVIDER=auto
# Backup providers, used automatically when the main one fails or its quota runs out.
# auto = every other provider that has a key below | none | e.g. groq,openai
LLM_FALLBACKS=auto

# 1) Google Gemini - main provider, free tier
#    Get a key: https://aistudio.google.com/apikey  (sign in with Google > Create API key)
#    Your free limits are shown in AI Studio under "Rate limits".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# 2) Groq - backup provider, free tier (about 1,000 requests and 200K tokens a day on gpt-oss-120b)
#    Get a key: https://console.groq.com/keys  (sign up > Create API Key)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 3) OpenAI - optional, paid. Key: https://platform.openai.com/api-keys
#    (xAI Grok also works here: OPENAI_BASE_URL=https://api.x.ai/v1, key from https://console.x.ai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Ollama (local models, no key) - install from ollama.com, then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# auto | gemini | openai | ollama | local | tfidf
EMBEDDING_PROVIDER=auto

LLM_TEMPERATURE=0.1
# Longest reply the model may write (the screening reply needs about 600-900 tokens)
LLM_MAX_OUTPUT_TOKENS=4096
# low | medium | high - only for "thinking" models such as gpt-oss on Groq; low = fewer tokens used
LLM_REASONING_EFFORT=low
# Free-tier friendly defaults: one resume at a time, at most 10 LLM calls a minute.
# With paid keys you can raise MAX_CONCURRENCY to 3-5 and set LLM_REQUESTS_PER_MINUTE=0 (no limit).
MAX_CONCURRENCY=1
LLM_REQUESTS_PER_MINUTE=10
MAX_UPLOAD_MB=10

# Accounts. The admin is created with:  python scripts/create_admin.py
SESSION_DAYS=7
ALLOW_REGISTRATION=true
REQUIRE_APPROVAL=true
DEMO_LOGIN=true

# Days a deleted recruiter's jobs and resumes are kept before they are purged (0 = purge at once)
DELETION_GRACE_DAYS=30
AUDIT_RETENTION_DAYS=365

# When to raise a security flag for the admin to review
FLAG_UPLOADS_PER_HOUR=100
FLAG_DUPLICATES_PER_DAY=10
FLAG_FOREIGN_ACCESS=5
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
